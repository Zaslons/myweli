# ── macOS ──────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Flutter / Dart build artifacts (safety net; mobile/.gitignore also covers these) ──
**/build/
**/.dart_tool/
**/coverage/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/generated_plugin_registrant.*

# ── IDE / editor ───────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp

# ── Secrets / signing (never commit) ───────────────────
*.env
.env
.env.*
**/key.properties
**/*.keystore
**/*.jks
**/*.p12
**/*.mobileprovision
**/secrets*.json
**/service-account*.json

# ── Claude Code local config (keep .claude/skills/ tracked) ──
.claude/settings.local.json
.claude/*.local.json
.claude/.session*
# Agent worktrees — transient checkouts, never part of the tree
.claude/worktrees/

# Wrangler's local cache. Created by `wrangler login` / any `wrangler` command
# run from the repo root. `cache/wrangler-account.json` holds the Cloudflare
# account id and name — not a credential, but local machine state that has no
# business in a shared repository, and it appeared in `git status` the first
# time the R2 provisioning script was run from here.
.wrangler/

# Vercel's local project link. Created by `vercel link` / any `vercel` command
# run from the repo root. `project.json` holds the project and org ids — not
# credentials, but local machine state, and the same reason `.wrangler/` is
# above: it appeared in `git status` the first time the Preview/Production env
# split was configured from here.
.vercel/
