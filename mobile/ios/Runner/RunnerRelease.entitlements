<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs for RELEASE builds. `production` is not cosmetic: a build signed
	     with `development` gets a SANDBOX APNs token, and a production FCM send
	     to it is silently dropped. TestFlight and the App Store both need this.
	     Wired per-configuration by tool/setup_flavours.rb. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Sign in with Apple (rule 4.8) — see Runner.entitlements for why this
	     was missing. It must be in BOTH files: Debug/Profile sign against
	     Runner.entitlements and Release against this one, so a key in only one
	     of them works in exactly the builds nobody ships. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
