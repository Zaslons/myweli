<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Per-flavour, set by tool/setup_flavours.rb — ONE Info.plist serves both
	     apps, so a literal here is the consumer's client in the Pro build.
	     Same mechanism as $(APP_DISPLAY_NAME) above. -->
	<key>GIDClientID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
		<string>waze</string>
		<string>dgis</string>
		<string>yandexmaps</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCalendarsUsageDescription</key>
	<string>MyWeli ajoute vos rendez-vous à votre calendrier.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>MyWeli ajoute vos rendez-vous à votre calendrier.</string>
	<key>NSCameraUsageDescription</key>
	<string>$(CAMERA_USAGE_DESCRIPTION)</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>$(LOCATION_USAGE_DESCRIPTION)</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>$(PHOTO_LIBRARY_USAGE_DESCRIPTION)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Push: lets APNs wake the app for a notification. Flutter 3.44's UIScene
	     migration rewrote this file and dropped this comment; restored. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- FALSE, deliberately, since 2026-08-27. `true` arrived in the branding
	     P4 native-splash rewrite (144ef89) with no stated rationale — splash
	     collateral never scoped back — and hid the time/battery/network in
	     BOTH apps until the owner noticed during the demo-salon curation.
	     `mobile/test/infra/ios_status_bar_test.dart` pins both keys. -->
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- TRUE so Flutter's SystemUiOverlayStyle / AnnotatedRegion actually
	     control icon brightness per screen — with `false` the plist is the
	     sole authority and the dark-surface screens (story viewer, photo
	     lightboxes) could never request light icons. -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Export compliance. MyWeli uses only HTTPS/TLS provided by the OS and
	     Apple's own crypto for the Sign in with Apple nonce — no proprietary or
	     non-standard encryption. Declaring it here means every upload stops
	     asking, and the answer stops depending on who is doing the upload.
	     If a future release ships its own crypto, this must be revisited. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
