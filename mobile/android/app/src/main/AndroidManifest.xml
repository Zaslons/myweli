<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required in release for the API client + push (debug adds its own). -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- geolocator requires the APP to declare these; the plugin ships none.
         Without them `Geolocator.requestPermission()` returns denied without
         ever showing the OS dialog, so the map's locate-me, « Près de moi » and
         the pro salon pin all dead-ended on a French message asking the user to
         grant a permission they were never offered. iOS had its usage string
         from the start; Android was simply missing.
         COARSE as well as FINE: every use here centres a map or picks the
         nearest commune, and a user who grants only approximate location should
         get the feature rather than the dead end. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Android 13+: the runtime notification permission. firebase_messaging's
         requestPermission() raises the dialog; without this it can't.
         Design: docs/design/push-notifications-app.md -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Push (FCM). The channel id MUST match the one the backend stamps
             on every message (FcmV1PushProvider.androidChannelId) and the one
             the app creates at boot (kPushChannelId) — otherwise a background
             notification lands in an unnamed default channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="myweli_default" />
        <!-- The status-bar glyph (Android masks it to a silhouette). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_myweli" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ package visibility: without a <queries> entry per
             scheme, `url_launcher` cannot SEE an app that handles it, so
             `launchUrl` returns false and every external link silently does
             nothing. Recorded as a TODO at docs/ROADMAP.md:200 and never done.

             It matters most for the one link the user cannot work around: the
             « Mettre à jour » button on the version-gate screen
             (docs/design/client-version-gate.md). A dead button there strands
             someone on a build we have deliberately blocked, with no way out.

             `https` covers the Play listing URL and every legal/support link;
             `market` covers the direct-to-Play-app deep link. `tel` and the
             WhatsApp/`geo` links are separate schemes with their own call
             sites — left alone here rather than widened speculatively. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="market"/>
        </intent>
    </queries>
</manifest>
