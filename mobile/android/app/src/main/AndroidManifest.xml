<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required in release for the API client + push (debug adds its own). -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- geolocator requires the APP to declare location; the plugin ships
         none, and asks for exactly what the merged manifest declares
         (PermissionManager.java:209-232). Without a declaration the dialog
         never shows.
         APPROXIMATE ONLY here, for both apps: the client centres a map and
         picks the nearest commune, which approximate does, and a client app
         without precise location needs no Play declaration (A6, decision 272,
         docs/design/consumer-location.md). PRECISE location is MyWeli Pro's
         alone, for the salon's published pin: src/pro/AndroidManifest.xml,
         merged into Pro's build only. Pinned in source by
         test/infra/android_location_permission_test.dart; the client APK is
         read in CI by tool/verify_android_location.sh. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Android 13+: the runtime notification permission. firebase_messaging's
         requestPermission() raises the dialog; without this it can't.
         Design: docs/design/push-notifications-app.md -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The portrait lock on MainActivity (below) makes Play infer this
         feature as REQUIRED, and Play then hides the app from every device
         that does not report it: 27 devices at build 785, and the closed
         track's check named phones, tablets, desktop and Android XR. Declared
         optional, the lock stays and the devices come back
         (docs/design/android-play-release.md §11, 2026-11-19). CI reads the
         built APK for it: tool/verify_android_portrait_optional.sh. -->
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Portrait, as on the iPhone (B7.9, decision 26 —
                 docs/design/pro-app-batch7.md §2.9). Android 16+ ignores the
                 lock on large screens, by the system's rule: a tablet still
                 gets landscape. -->
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Push (FCM). The channel id MUST match the one the backend stamps
             on every message (FcmV1PushProvider.androidChannelId) and the one
             the app creates at boot (kPushChannelId) — otherwise a background
             notification lands in an unnamed default channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="myweli_default" />
        <!-- The status-bar glyph (Android masks it to a silhouette). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_myweli" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ package visibility: without a <queries> entry per
             scheme, `url_launcher` cannot SEE an app that handles it, so
             `launchUrl` returns false and every external link silently does
             nothing. Recorded as a TODO at docs/ROADMAP.md:200 and never done.

             It matters most for the one link the user cannot work around: the
             « Mettre à jour » button on the version-gate screen
             (docs/design/client-version-gate.md). A dead button there strands
             someone on a build we have deliberately blocked, with no way out.

             `https` covers the Play listing URL and every legal/support link;
             `market` covers the direct-to-Play-app deep link. The WhatsApp/
             `geo` links are separate schemes with their own call sites.

             `tel` (B7.11 — docs/design/pro-app-batch7.md §2.11): every
             « Appeler » goes through `callPhone`, which opens `tel:` without
             asking `canLaunchUrl` — that question is what made two buttons
             dead here. Declared anyway, so any future `canLaunchUrl(tel:)`
             answers truthfully. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="market"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
