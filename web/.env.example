# Environment for the web (Next.js). Copy to `.env.local` for `npm run dev`;
# production values live in Vercel (docs/DEPLOYMENT.md, Phase D). Every
# NEXT_PUBLIC_* value is inlined into the browser bundle at BUILD time — public
# by construction, so never put a secret in one.

# --- API -------------------------------------------------------------------
# Server-side BFF base (route handlers, server components). Never in a bundle.
API_BASE_URL=http://localhost:8080
# Public base for the typed client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Canonical site origin for metadata / JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Maps (docs/design/map-basemap-key.md) ---------------------------------
# The WEB CARTO basemaps key, restricted in the CARTO dashboard to the
# myweli.com hosts (the apps use their own key, CARTO_BASEMAPS_KEY in Secret
# Manager). Unset → the keyless GL style, which CARTO still serves today.
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=

# --- Sign-in ---------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# --- Contact & app install -------------------------------------------------
NEXT_PUBLIC_MYWELI_WHATSAPP=
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=

# --- Error reporting (unset DSN → the SDK is inert) ------------------------
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
# Defaults to VERCEL_GIT_COMMIT_SHA on Vercel.
NEXT_PUBLIC_RELEASE=
