# Environment for the web (Next.js). Copy to `.env.local` for `npm run dev`;
# production values live in Vercel (docs/DEPLOYMENT.md, Phase D). Every
# variable you SET for the web is here; the ones the platform or the build set
# (VERCEL_ENV, VERCEL_GIT_COMMIT_SHA, SENTRY_AUTH_TOKEN) are at the bottom,
# commented. Every NEXT_PUBLIC_* value is inlined into the browser bundle at
# BUILD time — public by construction, so never put a secret in one.

# --- API -------------------------------------------------------------------
# Server-side BFF base (route handlers, server components). Never in a bundle.
API_BASE_URL=http://localhost:8080
# Public base for the typed client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Canonical site origin for metadata / JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Maps (docs/design/map-basemap-key.md) ---------------------------------
# The WEB CARTO basemaps key (value: Secret Manager CARTO_BASEMAPS_WEB_KEY),
# restricted in the CARTO dashboard to myweli.com + www.myweli.com — the apps
# use their own key, CARTO_BASEMAPS_KEY. Set → the style AND every CARTO
# request the maps make carry it. Unset → the keyless GL style and keyless
# vector tiles, which CARTO still serves free.
# Leave it EMPTY, here and in Vercel, until CARTO requires a key on vector:
# a key spends the free tier all keys share, on tiles that are free keyless
# (map-basemap-key.md §7). The day CARTO changes, production-checks.yml's
# `basemap` job goes red; then set it in Vercel, Production only (a preview
# host is not on the key → 403), and redeploy (§9 step 3). Locally a keyed
# map loads only on a host the key allows — localhost is not one.
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=

# --- Sign-in ---------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# --- Browser notifications, web Pro (docs/design/web-pro-browser-push.md) ---
# The Firebase WEB app of the project that holds the backend's FCM_* service
# account (the same project — another one answers SENDER_ID_MISMATCH), and its
# « Web Push certificates » public key. Public by nature; restrict the API key
# to the myweli.com referrers in the Google console. Any one empty → the
# feature hides itself (no band on the Accueil, no row on Notifications).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# NEXT_PUBLIC_E2E_PUSH_TOKEN is the e2e build's alone (playwright*.config.ts) —
# never set it anywhere else.

# --- Contact & app install -------------------------------------------------
NEXT_PUBLIC_MYWELI_WHATSAPP=
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=

# --- Error reporting (unset DSN → the SDK is inert) ------------------------
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
# Defaults to VERCEL_GIT_COMMIT_SHA on Vercel.
NEXT_PUBLIC_RELEASE=

# --- Set for you, never here ----------------------------------------------
# Vercel's own: production | preview | development. Unset (local, CI) = the
# production posture: a failed build-time fetch fails the build
# (lib/build-posture.ts, next.config.mjs).
# VERCEL_ENV=
# Vercel's own: the commit being built; NEXT_PUBLIC_RELEASE defaults to it.
# VERCEL_GIT_COMMIT_SHA=
# Build-time only, read by @sentry/nextjs to upload source maps; the upload
# is skipped when unset. A credential: never NEXT_PUBLIC_, never in git.
# SENTRY_AUTH_TOKEN=
