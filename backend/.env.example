# Copy to `.env` for local dev and fill in. NEVER commit a real `.env`
# (it is gitignored; CI secret-scans the repo). Production supplies these via
# the platform's secret manager, not a file.

# Runtime environment: dev | staging | prod. Anything else fails at boot —
# an unrecognised value used to mean "dev", so a typo on the production service
# silently disabled every guard below.
#
# It answers two questions, which is why there are three values and not two:
#   · guards on (staging + prod) — every "must be set" check below fails fast,
#     so staging rehearses production rather than tolerating a gap;
#   · is prod (prod only) — the OTP is returned inline as `devCode` in dev AND
#     staging, because staging has no SMS channel and nobody could sign in
#     otherwise. Production never returns it.
# docs/design/infra-staging.md §1.1
ENV=dev

# HS256 signing key for access-token JWTs. Generate a long random value, e.g.:
#   dart -e "import 'dart:math'; import 'dart:convert'; void main(){final r=Random.secure(); print(base64Url.encode(List<int>.generate(48,(_)=>r.nextInt(256))));}"
JWT_SECRET=replace-with-a-long-random-secret

# Seed super-admin for the internal admin console (docs/design/admin-console.md).
# On first boot an admin with this email is created if absent (idempotent; the
# password is bcrypt-hashed). Leave unset to skip seeding. No admin self-signup.
# ADMIN_EMAIL=ops@myweli.com
# ADMIN_PASSWORD=replace-with-a-strong-password

# Postgres connection. When set, the backend uses Postgres-backed repositories;
# unset → in-memory (fine for dev / CI-without-DB). Uncomment + fill to enable.
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/myweli

# --- Auth overhaul (docs/design/auth-social-email.md) ------------------------
# Consumer sign-in methods, comma-separated. Unset → all methods available but
# WITHOUT prod fail-fast (unconfigured verifiers just reject — keeps a legacy
# deploy booting). Set explicitly to enforce config at boot. Launch config
# disables the costly SMS path:
# AUTH_METHODS=google,apple,email
# Google Sign-In: OAuth client-ID allowlist (web + Android + iOS audiences).
# REQUIRED in production while "google" is enabled. Not secret, but env-managed.
# GOOGLE_CLIENT_IDS=1234-web.apps.googleusercontent.com,1234-android.apps.googleusercontent.com,1234-ios.apps.googleusercontent.com
# Sign in with Apple: iOS bundle id + the web Service ID.
# REQUIRED in production while "apple" is enabled.
# APPLE_CLIENT_IDS=com.myweli.app,com.myweli.web
# Email OTP via Resend (https://resend.com). The key is a SECRET — never commit.
# REQUIRED in production while "email" is enabled; unset → a no-network log
# provider (dev/CI; devCode is echoed inline off-prod).
# RESEND_API_KEY=re_replace-with-resend-api-key
# EMAIL_FROM=MyWeli <no-reply@myweli.com>

# Object storage for image uploads (Cloudflare R2; S3-compatible). When all are
# set, POST /uploads/sign issues real presigned uploads; unset → a no-network
# Fake (dev/CI). REQUIRED in production. The keys are secrets — never commit a
# real .env. Design: docs/design/pro-image-upload-pipeline.md.
#   R2_ENDPOINT wins if set (use it for AWS S3 / Supabase / MinIO); otherwise
#   the endpoint is derived from R2_ACCOUNT_ID.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=myweli-uploads
# R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
# R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# R2_PUBLIC_BASE_URL=https://cdn.myweli.com
#   A SEPARATE, PRIVATE bucket for KYC identity documents (no public domain
#   bound to it — never web-reachable). Design: docs/design/pro-kyc.md.
# R2_KYC_BUCKET=myweli-kyc-private
#   A SEPARATE, PRIVATE bucket for deposit-payment screenshots (also never
#   web-reachable; kept apart from KYC so it can have its own retention/access).
#   Design: docs/design/consumer-deposit.md.
# R2_DEPOSIT_BUCKET=myweli-deposits-private

# Outbound messaging (SMS + optional WhatsApp via Twilio). When SID + AUTH_TOKEN +
# SMS_FROM are set the backend sends via Twilio; unset → a no-network log provider
# (dev/CI). SMS is REQUIRED in production. Secrets — never commit a real .env. The
# `*_FROM` values are the Twilio senders (SMS may be an Alphanumeric Sender ID like
# `Myweli`; the WhatsApp one is E.164 without the `whatsapp:` prefix — the adapter
# adds it). Design: docs/design/messaging-notifications.md.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
# TWILIO_SMS_FROM=Myweli
#   OPTIONAL — until a WhatsApp sender is approved, leave unset and WhatsApp sends
#   fall back to SMS (SMS-first launch).
# TWILIO_WHATSAPP_FROM=+1XXXXXXXXXX
#   Shared secret guarding the delivery-status webhook. When both this and
#   PUBLIC_BASE_URL are set, each Twilio send attaches a StatusCallback of
#   PUBLIC_BASE_URL/webhooks/messaging/status?secret=THIS, so delivery status
#   flows back to the outbox. Unset → no status tracking (webhook open in dev).
#   Design: docs/design/messaging-notifications.md §5.
# MESSAGING_WEBHOOK_SECRET=replace-with-a-long-random-secret

# SMS via Termii (West-Africa BSP — ~14 FCFA / ~$0.023 per SMS to Côte d'Ivoire,
# vs Twilio's ~$0.49). When TERMII_API_KEY + TERMII_SENDER_ID are set the backend
# can send via Termii. Plain-SMS only — our OTP stays server-owned (we never use
# Termii's Token API). A branded sender ID needs operator/ARTCI registration; a
# generic/shared sender works pre-registration. Design: docs/design/messaging-termii.md.
# TERMII_API_KEY=replace-with-termii-api-key
# TERMII_SENDER_ID=Myweli
# TERMII_BASE_URL=https://api.ng.termii.com   # optional (region endpoint)
# TERMII_CHANNEL=generic                       # optional: generic | dnd

# Which provider sends SMS: `termii` | `twilio` | `log` | `disabled`. Unset →
# auto-detect, preferring Termii when its creds are set, else Twilio. Set this
# to switch instantly (the other provider's config can stay for rollback).
#
# `disabled` = messaging deliberately OFF, and the ONLY value besides a real
# provider that production accepts. MyWeli launches before company registration
# and both SMS channels need a registered entity (Termii's branded sender needs
# ARTCI; a WhatsApp number needs Meta verification), so at launch there is no
# channel to configure. It reports every send as FAILED, so the outbox records
# what was never delivered — unlike `log`, which claims success and is refused
# in production for exactly that reason.
# MESSAGING_PROVIDER=termii

# Public base URL of THIS API (no trailing slash), e.g. https://api.myweli.com.
# Used to build the Twilio delivery-status StatusCallback (see above). Optional —
# when unset, sends carry no StatusCallback (delivery tracking off).
# PUBLIC_BASE_URL=https://api.myweli.com

# Secret for the internal cron routes. Cloud Scheduler POSTs
# /internal/cron/reminders with header `X-Cron-Secret: THIS` every ~15 min to
# dispatch the 24h/2h reminders, and /internal/cron/subscriptions nightly.
# Unset (and no OIDC config below) → the routes 404, i.e. the surface does not
# exist. Design: docs/design/messaging-notifications.md.
#
# The `?secret=` query-parameter form was REMOVED — it wrote a production
# credential into access logs, LB logs, and anything else that records a URL.
# The header is the only accepted form of this value.
# CRON_SECRET=replace-with-a-long-random-secret
#
# **Transitional.** Cloud Scheduler cannot reference Secret Manager for headers,
# so this value sits in the job config as a LITERAL — `gcloud scheduler jobs
# describe` prints it to anyone with `cloudscheduler.jobs.get`, which today
# includes the default compute service account (it holds roles/editor).
#
# The preferred path is the OIDC token Cloud Scheduler already sends. Set BOTH of
# the following to enable it; the header then stays only until a real scheduled
# run is seen authenticating on the token (grep the logs for `cron_auth_legacy`).
#
#   CRON_OIDC_AUDIENCE   the job's `audience` — https://api.myweli.com
#   CRON_SERVICE_ACCOUNT the job's `serviceAccountEmail`. REQUIRED alongside the
#                        audience: `aud` is a public string that any Google
#                        account can mint a token for, so without pinning the
#                        principal the check authenticates anyone.
# CRON_OIDC_AUDIENCE=https://api.myweli.com
# CRON_SERVICE_ACCOUNT=myweli-scheduler@myweli.iam.gserviceaccount.com

# Push channel selector. `disabled` is the supported way to run a GUARDED
# environment (staging or prod) with no push at all — it reports the truth
# (sent: 0, error) rather than a phantom delivery, and it is never auto-detected,
# so "nothing configured" still hits the fail-fast below. Staging needs this: its
# Firebase project does not exist until the app has its own bundle ids
# (docs/design/infra-staging.md §4). Leave unset everywhere else.
# PUSH_PROVIDER=disabled

# Push notifications (Firebase Cloud Messaging, HTTP v1). When all three are set
# the backend sends real pushes; unset → a no-network log provider (dev/CI).
# REQUIRED in staging and production (or PUSH_PROVIDER=disabled, above). From the
# Firebase service-account JSON. The private key
# is a secret — never commit a real .env. Keep its `\n` newline escapes (the app
# unescapes them). Design: docs/design/push-notifications-fcm.md.
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
#   The service-account private key (the `private_key` field of the JSON), with
#   its newline escapes kept, wrapped in quotes. Paste the real value here.
# FCM_PRIVATE_KEY=replace-with-the-service-account-private-key-pem

# Browser origins allowed to call the API (CORS) for the Next.js web app(s),
# comma-separated. Dev defaults to http://localhost:3000 when unset; prod must
# set the real web origin(s) (deny-by-default; never `*`).
# WEB_ORIGINS=https://myweli.com,https://www.myweli.com

# Pricing pivot (R2a): 'on' = past-grace salons get unpublished by the
# daily cron; 'off' (default) = warnings only (cold-start leniency).
SUBSCRIPTION_ENFORCEMENT=off

# --- Smoke acceptance gate (Q1b) --------------------------------------------
# Lets tool/smoke/funnel_smoke_test.dart authenticate against ENV=prod, where
# `devCode` is suppressed. UNSET BY DEFAULT and unset off-prod — dev/CI echo
# `devCode` anyway, so this is only ever set on a production target while a
# cutover gate is being run, then removed.
#
# Disclosure needs BOTH this secret (>=32 chars, constant-time compared against
# the X-Smoke-Secret header) AND an identity ending in the RFC 2606 `.test` TLD.
# The suffix is compiled in, so no value here can expose a real address.
# docs/design/backend-q1b-smoke-seam.md · threat model T60.
# SMOKE_OTP_SECRET=

# Error reporting (Sentry). UNSET → reporting is a no-op, so dev and CI need no
# setup and a missing DSN is never a boot failure. Deliberately NOT part of the
# ENV=staging/prod fail-fast set: an unreported error is bad, but a backend that
# refuses to start because its telemetry is unconfigured is worse than both.
#
# The DSN is not a secret in the credential sense — it only permits *writing*
# events — but it is env-managed like everything else.
# Design: docs/design/observability-error-reporting.md
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#
# The deployed image tag, which is what makes Sentry's release health mean
# anything — errors group by the exact artifact that produced them. Set by the
# deploy workflow; unset locally.
# RELEASE=8bdfb9b
